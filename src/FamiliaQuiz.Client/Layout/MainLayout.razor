@inherits LayoutComponentBase
@implements IDisposable
@inject GameClient Game

<div class="app">
    <header class="topbar">
        <span class="brand">🪜 FamiliaQuiz</span>
        @if (Game.State is { } s)
        {
            <span class="topbar-room">Sala <strong>@s.RoomCode</strong></span>
        }
        <span class="conn conn-@Game.Status.ToString().ToLowerInvariant()" title="Conexão com o servidor">
            @(Game.Status switch
            {
                ConnectionStatus.Connected => "● Conectado",
                ConnectionStatus.Reconnecting => "● Reconectando…",
                ConnectionStatus.Connecting => "● Conectando…",
                _ => "● Sem conexão",
            })
        </span>
    </header>

    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized() => Game.Changed += OnChanged;

    // Changed can fire from a SignalR callback, so marshal back to the renderer with InvokeAsync.
    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Game.Changed -= OnChanged;
}
