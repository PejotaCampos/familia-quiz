@implements IDisposable
@inject GameClient Game
@inject KeyboardService Keyboard

@if (State.Round is { } round)
{
    var special = round.Kind == RoundKind.Special;
    @if (special) { <div class="special-banner">🎲 Rodada especial!</div> }
    <div class="question-header">
        <span class="muted">Pergunta @round.Number sobre 👑 <strong>@State.King()?.Name</strong></span>
        <h1 class="question">@round.Text</h1>
    </div>

    <div class="options @(special ? "options-grid" : "")">
        @for (var i = 0; i < round.Options.Count; i++)
        {
            var idx = i;
            var pickers = State.Guesses.Where(g => g.OptionIndex == idx).Select(g => State.NameOf(g.PlayerId)).ToList();
            <div class="option @(special ? "option-card" : "") @(idx == State.CorrectOptionIndex ? "is-correct" : "is-dim")">
                <span class="option-key">@(idx == State.CorrectOptionIndex ? "✔" : (idx + 1).ToString())</span>
                <OptionVisual Option="round.Options[idx]" />
                @if (pickers.Count > 0)
                {
                    <span class="pickers">@string.Join(", ", pickers)</span>
                }
            </div>
        }
    </div>

    <p class="big center">
        @if (Winners.Count == 0)
        {
            <text>Ninguém acertou! 😮</text>
        }
        else
        {
            <text>🎉 Acertaram: <strong>@string.Join(", ", Winners)</strong></text>
        }
    </p>

    @if (!State.AmIKing() && State.MyGuess is not null)
    {
        <p class="center">@(State.MyGuess == State.CorrectOptionIndex ? "Você acertou e subiu um degrau! 🪜" : "Não foi dessa vez…")</p>
    }

    @if (State.TopPlayerIds.Count == 1)
    {
        <p class="big center">🏆 <strong>@State.NameOf(State.TopPlayerIds[0])</strong> chegou ao topo e será o novo Rei!</p>
    }
    else if (State.TopPlayerIds.Count > 1)
    {
        <p class="big center">🏆 Empate no topo! @(State.AmIKing() ? "Escolha quem será o novo Rei:" : $"{State.King()?.Name} vai escolher o novo Rei…")</p>
    }
    else if (State.NextRoundIsSpecial)
    {
        <p class="special-banner">🎲 Alguém chegou ao meio da escada: a próxima rodada é especial!</p>
    }

    @if (State.AmIKing())
    {
        @if (State.TopPlayerIds.Count > 1)
        {
            <div class="choice-grid">
                @foreach (var id in State.TopPlayerIds)
                {
                    <button class="btn btn-choice" @onclick="() => Game.ContinueAfterRevealAsync(id)">👑 @State.NameOf(id)</button>
                }
            </div>
        }
        else
        {
            <button class="btn btn-primary btn-block" @onclick="() => Game.ContinueAfterRevealAsync(null)">
                @(State.TopPlayerIds.Count == 1 ? $"Coroar {State.NameOf(State.TopPlayerIds[0])} 👑"
                  : State.NextRoundIsSpecial ? "Rodada especial 🎲" : "Próxima pergunta ▶")
                <span class="kbd">Enter</span>
            </button>
        }
    }
    else
    {
        <p class="muted center">Aguardando @State.King()?.Name continuar…</p>
    }
}

@code {
    [Parameter, EditorRequired] public RoomStateDto State { get; set; } = default!;

    private List<string> Winners => State.Guesses.Where(g => g.IsCorrect).Select(g => State.NameOf(g.PlayerId)).ToList();

    protected override void OnInitialized() => Keyboard.KeyPressed += OnKeyAsync;

    private async Task OnKeyAsync(string key)
    {
        if (key == "Enter" && State.AmIKing() && State.TopPlayerIds.Count <= 1)
            await Game.ContinueAfterRevealAsync(null);
    }

    public void Dispose() => Keyboard.KeyPressed -= OnKeyAsync;
}
