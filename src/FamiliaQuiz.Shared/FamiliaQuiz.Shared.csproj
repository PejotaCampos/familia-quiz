<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hub contract shared by the server and every client (Blazor today, Unity later).
    netstandard2.1 + C# 9 keeps it referenceable from Unity: plain classes only,
    no records, no ASP.NET/Blazor dependencies, no UI strings.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
